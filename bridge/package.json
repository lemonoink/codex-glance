{
  "name": "codex-glance-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx src/main.ts",
    "demo": "tsx src/demo.ts",
    "ports": "tsx src/list-ports.ts",
    "build": "tsc -p tsconfig.build.json",
    "test": "tsx --test test/*.test.ts",
    "lint": "tsc -p tsconfig.json && prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\""
  },
  "dependencies": {
    "serialport": "13.0.0"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "7.0.2"
  }
}
